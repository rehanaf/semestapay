{
  "name": "semestapay-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:admin": "turbo dev --filter=web-admin",
    "dev:school": "turbo dev --filter=web-school",
    "dev:merchant": "turbo dev --filter=web-merchant",
    "dev:backend": "cd apps/backend && php artisan serve --port=8000",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "packageManager": "pnpm@11.17.0"
}
